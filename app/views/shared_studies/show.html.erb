<% content_for :title, "#{@study.name} — Shared Study" %>

<div class="ps-root is-shared">
  <header class="ui-appbar">
    <div class="ui-appbar-start">
      <%= link_to root_path, class: "ui-brand" do %>
        <span class="ui-brand-mark" aria-hidden="true"><%= icon(:book) %></span>
        <span class="ui-brand-name">BiblioRata</span>
      <% end %>
    </div>
    <div class="ui-appbar-center">
      <span class="ui-appbar-title ps-study-name"><%= @study.name %> &middot; shared</span>
    </div>
    <div class="ui-appbar-end">
      <%= link_to "Open BiblioRata", root_path, class: "ui-btn is-sm is-primary" %>
    </div>
  </header>
  <div class="ps-shell">
    <main class="ps-workspace <%= workspace_cols_class(@study.pane_count) %>">
      <% @panes.each do |pane| %>
        <div class="ps-pane">
          <div class="ps-pane-head">
            <div class="ps-pane-index"><%= pane_numeral(pane.position) %></div>
            <div class="ps-shared-ref"><%= pane.reference.presence || "—" %></div>
            <% if pane.effective_translation %>
              <div class="ps-trans" style="cursor: default;">
                <%= pane.effective_translation.code %>
              </div>
            <% end %>
          </div>
          <% content = pane.content %>
          <% if content.ok? %>
            <div class="ps-verses">
              <div class="ref-title">
                <span><%= reference_title(content.book, content.parsed.chapter) %></span>
                <span class="tag">&middot; <%= content.translation.name %></span>
              </div>
              <div class="rule"></div>
              <%# Our own read-only verse partial: scripture_verse links verse
                  numbers / Strong's words into the owner's xref + lexicon
                  drawers, which 404 for a viewer. %>
              <div class="ps-verse-body">
                <% content.verses.each_with_index do |v, i| %>
                  <%= render "shared_studies/verse", verse: v, book: content.book,
                        dropcap: i.zero? && v.verse_number == 1 %>
                <% end %>
              </div>
            </div>
            <% if pane.notes.present? %>
              <div class="ps-notes">
                <div class="ps-notes-head"><span>Notes</span></div>
                <%# Plain text: [[John 3:16]] wiki-links point at the owner's drawer. %>
                <div class="ps-notes-body"><%= simple_format(pane.notes) %></div>
              </div>
            <% end %>
          <% else %>
            <div class="ps-pane-empty">
              <div class="orn">&#10086;</div>
              <div class="lead">Pane <%= pane_numeral(pane.position) %> is empty</div>
            </div>
          <% end %>
        </div>
      <% end %>
    </main>
  </div>
</div>
