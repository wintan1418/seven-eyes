<!DOCTYPE html>
<html lang="en">
  <head>
    <%# In the iOS/Android apps the title becomes the native header, so drop the
        site-name suffix ("Privacy Policy · BiblioRata" → "Privacy Policy"). %>
    <title><%= hotwire_native_app? ? native_page_title(content_for(:title)) : (content_for(:title) || "BiblioRata") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="BiblioRata">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <%# Inter for the interface, Source Serif 4 for Scripture; EB Garamond and
        Cinzel stay for the sepia theme and the projector. %>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..700&family=Cinzel:wght@400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Noto+Sans+Symbols+2&family=UnifrakturMaguntia&display=swap" rel="stylesheet">

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <%= theme_color_meta_tags %>
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="BiblioRata">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <%# Theme comes from the ps_reader_theme cookie (written by the theme controller) so
      dark-mode readers never see a light flash on a Turbo visit. %>
  <%# Inside the apps (Hotwire Native) body.hotwire-native hides the web chrome
      the native tab bar and top bar replace; data-native-* flags tell the apps
      who is signed in (they reload every tab when it flips). %>
  <body data-controller="guide theme sheets" data-theme="<%= reader_theme %>"
        <%= tag.attributes(class: ("hotwire-native" if hotwire_native_app?),
                           data: { native_signed_in: authenticated?.present? }) %>>
    <%# Pages without the app bar (guide, sign-in, plans, legal…) still get the
        light/dark switch; hidden wherever an app bar already has one, and on
        the projector / stage screens. %>
    <%= render "shared/theme_toggle", extra_class: "ui-theme-float" %>
    <div data-controller="offline">
      <div class="ps-offline-badge" data-offline-target="badge" hidden>&#9679; Offline</div>
    </div>
    <%= yield %>
    <%= testimonials_tag %>
  </body>
</html>
