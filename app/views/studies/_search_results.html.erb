<%# The reader's search sheet results. locals: study, query, result (ScriptureSearch::Result), translation
    Ranked like the /search page: the words as typed side by side, then every
    word, then some of them — Bible order inside each. Tapping a verse opens
    its whole chapter in the pane, scrolled to it and marked (verse-focus).
    OFFLINE: search_controller draws the same cards from a downloaded Bible. %>
<%= turbo_frame_tag "verse_search_results", class: "ps-ai-results" do %>
  <% if result.blank? %>
    <div class="ps-ai-hint">Type a word or phrase &mdash; verses holding every word come first.</div>
  <% else %>
    <div class="ps-ai-resultcount sr-summary"><%= search_summary(result, translation) %></div>
    <% primary = study.panes.first %>
    <ol class="sr-list">
      <% result.hits.each_with_index do |hit, i| %>
        <% if hit.tier == :partial && result.words.size > 1 && (i.zero? || result.hits[i - 1].tier != :partial) %>
          <li class="sr-divider">With some of the words</li>
        <% end %>
        <li class="sr-hit">
          <%= open_in_pane_button(study, primary, hit.reference, translation: translation, css: "sr-open") do %>
            <span class="sr-ref"><%= hit.reference %></span>
            <span class="sr-text"><%= hit.highlighted %></span>
          <% end %>
          <% if study.pane_count > 1 %>
            <div class="ps-xref-actions">
              <% study.panes.each do |pane| %>
                <%= open_in_pane_button(study, pane, hit.reference, translation: translation) %>
              <% end %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% end %>
<% end %>
