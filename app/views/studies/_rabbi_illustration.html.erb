<%# locals: study, verse_id, verse_ids, selection, image (data URL or nil), caption, state %>
<%# optional: remaining (Integer or nil), style (String or nil), annotations (Array or nil) %>
<% remaining = local_assigns.fetch(:remaining, nil) %>
<% annotations = Array(local_assigns.fetch(:annotations, nil)) %>
<% style = local_assigns.fetch(:style, nil).presence || RabbiIllustration::DEFAULT_STYLE %>
<% exhausted = state == :quota || remaining == 0 %>
<% style_labels = { "realistic" => "◐ Clean view", "illuminated" => "✦ Illuminated", "labeled" => "① Labeled" } %>
<%= turbo_frame_tag "rabbi_illustration_frame", class: "ps-rabbi-illus" do %>
  <% if image.present? %>
    <figure class="ps-rabbi-figure">
      <%= image_tag image, alt: (caption || "Illustration of the passage"), class: "ps-rabbi-illus-img" %>
      <figcaption><%= caption.presence || "An artist's rendering — imagined, not a photograph." %></figcaption>
    </figure>
    <% if annotations.any? %>
      <div class="ps-rabbi-notice">
        <div class="ps-rabbi-notice-head">&#9635; What to notice</div>
        <ol class="ps-rabbi-notice-list">
          <% annotations.each do |a| %>
            <li>
              <span class="lbl"><%= a.label %></span><%= " — #{a.note}" if a.note.present? %>
            </li>
          <% end %>
        </ol>
      </div>
    <% end %>
  <% elsif state == :quota %>
    <div class="ps-rabbi-draw-note">
      &#9203; You&rsquo;ve used today&rsquo;s <%= IllustrationQuota.limit %> illustrations.
      More tomorrow &mdash; the daily limit keeps costs in hand.
    </div>
  <% elsif state == :none %>
    <div class="ps-rabbi-draw-note">Nothing to picture in this passage.</div>
  <% elsif state == :no_key %>
    <div class="ps-rabbi-draw-note">&#9888; No image provider configured &mdash; add <code>OPENAI_API_KEY</code> to illustrate.</div>
  <% elsif state == :api %>
    <div class="ps-rabbi-draw-note">Couldn&rsquo;t create the image just now &mdash; please try again.</div>
  <% end %>

  <% if verse_id.present? && !exhausted %>
    <div class="ps-rabbi-illus-controls">
      <%# Style chooser — each choice generates in that look. The current style is marked.
          POST, never a GET link: Turbo prefetches links on hover, and a prefetch here
          would silently generate an image and burn the daily quota. %>
      <div class="ps-rabbi-styles" role="group" aria-label="Illustration style">
        <% RabbiIllustration::STYLES.each_key do |key| %>
          <%= button_to style_labels[key],
                rabbi_illustration_study_path(study, verse_id: verse_id, verse_ids: verse_ids, q: selection, style: key),
                class: "ps-rabbi-style #{'is-on' if key == style}",
                form: { data: { turbo_frame: "rabbi_illustration_frame" }, style: "display:contents;" } %>
        <% end %>
      </div>

      <%= button_to rabbi_illustration_study_path(study, verse_id: verse_id, verse_ids: verse_ids, q: selection, style: style),
            class: "ps-rabbi-draw", form: { data: { turbo_frame: "rabbi_illustration_frame" }, style: "display:contents;" } do %>
        <%= image.present? ? "↻ A new illustration" : "✦ Illustrate this passage" %>
      <% end %>
      <span class="ps-rabbi-drawing">&#10022; Painting the scene&hellip; this can take ~15 seconds.</span>
      <% if remaining %>
        <span class="ps-rabbi-quota"><%= remaining %> left today</span>
      <% end %>
    </div>
  <% end %>
<% end %>
