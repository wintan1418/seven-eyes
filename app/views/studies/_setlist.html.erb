<%# locals: study, errored (optional invalid item) — the queue's Turbo Frame.
    The setlist controller takes the list over on connect: it merges these
    server items (data-items, rendered at data-server-time) with the device's
    copy and any changes still waiting to sync, and from then on renders the
    list itself (same markup as _setlist_item). Only a picture upload goes
    through this frame's form to the server; everything else is local-first. %>
<% errored = local_assigns[:errored] %>
<%= turbo_frame_tag "setlist" do %>
  <% items = study.setlist_items.in_order.to_a %>
  <ol class="ps-setlist-items" tabindex="0" role="listbox" aria-label="Queue — arrow keys to pick, Enter to preview"
      data-setlist-target="list"
      data-action="keydown->setlist#listKey"
      data-items="<%= items.map(&:as_queue_json).to_json %>"
      data-server-time="<%= (Time.current.to_f * 1000).to_i %>">
    <% if items.empty? %>
      <li class="ps-setlist-empty">Nothing queued yet &mdash; add the first item below.</li>
    <% end %>
    <% items.each do |item| %>
      <%= render "studies/setlist_item", item: item %>
    <% end %>
  </ol>

  <% selected_kind = errored&.kind || "scripture" %>
  <%= form_with url: study_setlist_items_path(study), method: :post,
        class: "ps-setlist-form kind-#{selected_kind}",
        html: { enctype: "multipart/form-data" },
        data: { setlist_target: "form", action: "submit->setlist#add" } do |f| %>
    <div class="err" data-setlist-target="error" <%= "hidden" unless errored %>><%= errored&.errors&.full_messages&.to_sentence %></div>
    <div class="kinds">
      <% { "scripture" => "&#167; Scripture", "song" => "&#9835; Song",
           "thought" => "&#10086; Thought", "picture" => "&#9670; Picture" }.each do |kind, lbl| %>
        <label class="<%= "is-on" if kind == selected_kind %>">
          <input type="radio" name="setlist_item[kind]" value="<%= kind %>" <%= "checked" if kind == selected_kind %>
                 data-action="setlist#kindChanged">
          <%= lbl.html_safe %>
        </label>
      <% end %>
    </div>
    <input type="text" name="setlist_item[reference]" class="ref-field" autocomplete="off" spellcheck="false"
           data-setlist-target="reference"
           data-action="input->setlist#referenceTyped keydown.esc->setlist#cancelEdit"
           value="<%= errored&.reference %>" placeholder="e.g. Jn 11:35, Rev 12:10; Jer 10:10-11">
    <div class="ref-hint" data-setlist-target="hint">Add several at once &mdash; separate with commas
      (<span class="eg">John 3:16, Rom 8:28, Ps 23</span>). Enter adds; keep typing the next.</div>
    <div class="ps-song-library">
      <button type="button" class="lib-toggle" data-action="setlist#toggleLibrary">
        &#9835; Pick from your songs &amp; the hymnal
      </button>
      <div class="lib-list" data-setlist-target="libraryList" hidden></div>
    </div>
    <input type="text" name="setlist_item[title]" class="title-field" autocomplete="off"
           data-setlist-target="title" data-action="keydown.esc->setlist#cancelEdit"
           value="<%= errored&.title %>" placeholder="Title — e.g. Amazing Grace, or Welcome">
    <textarea name="setlist_item[body]" rows="5" class="body-field"
              data-setlist-target="body" data-action="keydown.esc->setlist#cancelEdit"
              placeholder="Words to project. Leave a blank line between stanzas — each stanza becomes its own slide."><%= errored&.body %></textarea>
    <input type="file" name="setlist_item[image]" class="image-field" accept="image/*">
    <div class="image-hint image-field">Pictures only, up to 5&nbsp;MB &mdash; projected full-screen.</div>
    <div class="form-actions">
      <button type="submit" class="add" data-setlist-target="submit">&#43; Add to queue</button>
      <button type="button" class="cancel-edit" data-setlist-target="cancel" data-action="setlist#cancelEdit" hidden>Cancel</button>
    </div>
  <% end %>
<% end %>
