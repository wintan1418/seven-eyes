<%# The projector (?output=1) and stage (?stage=1) windows render this same page:
    mark them server-side so no onboarding (tour, prompts, banners) ever flashes
    on the big screen before presentation_controller boots. Everything new in
    the reading UI is marked [data-chrome] and hidden while presenting. %>
<% output_window = params[:output] == "1" || params[:stage] == "1" %>
<div class="ps-root rd-app<%= ' is-output' if output_window %><%= ' is-compare' if @study.pane_count > 1 %>"
     data-controller="ai-search search xref commentary lexicon rabbi <%= 'tour ' unless output_window %>shortcuts auth-gate new-study font-size presentation diff interlinear live setlist remote reader-header verse-lines"
     data-live-url-value="<%= study_live_path(@study) %>"
     data-live-active-code-value="<%= LiveSession.current_for(@study)&.code unless output_window %>"
     data-remote-url-value="<%= study_remote_path(@study) %>"
     data-setlist-library-url-value="<%= library_study_setlist_items_path(@study) %>"
     data-presentation-quick-find-url-value="<%= quick_find_study_path(@study) %>"
     data-font-size="<%= authenticated? ? current_user.font_size : 0 %>"
     data-font-size-url-value="<%= preferences_path %>"
     data-font-size-authenticated-value="<%= authenticated?.present? %>"
     data-tour-authenticated-value="<%= authenticated?.present? %>"
     data-tour-done-value="<%= (authenticated? && current_user.tour_completed_at.present?).present? %>"
     data-tour-url-value="<%= preferences_path %>">
  <%= render "studies/preach_chrome" %>
  <%= render "studies/app_bar", study: @study %>

  <div class="ps-shell">
    <main class="ps-workspace <%= workspace_cols_class(@study.pane_count) %>"
          data-controller="sync-scroll" data-sync-scroll-enabled-value="<%= @study.sync_scroll %>">
      <% @study.panes.each do |pane| %>
        <%= render "panes/pane", pane: pane %>
      <% end %>
    </main>
  </div>
  <%= render "studies/compare_bar", study: @study if @study.pane_count > 1 %>

  <% unless output_window %>
    <%= render "studies/menu_sheet", studies: @studies, active_id: @study.id, study: @study, new_study_modal: true %>
    <%= render "studies/passage_sheet" %>
    <%= render "studies/translation_sheet" %>
    <%= render "studies/reading_settings_sheet" %>
    <%= render "studies/more_sheet", study: @study %>
  <% end %>
  <%= render "studies/ai_search", study: @study %>
  <%= render "studies/search", study: @study %>
  <%= render "studies/xref_drawer" %>
  <%= render "studies/commentary_drawer" %>
  <%= render "studies/lexicon_drawer" %>
  <%= render "studies/rabbi_drawer", study: @study %>
  <%= render "studies/share_modal", study: @study %>
  <%= render "studies/live_modal" %>
  <%= render "studies/remote_modal" %>
  <%= render "studies/setlist_drawer", study: @study %>
  <%= render "studies/auth_prompt" unless authenticated? %>
  <%= render "studies/new_study_modal" %>
</div>
