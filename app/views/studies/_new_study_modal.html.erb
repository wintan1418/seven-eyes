<div class="ps-modal-shroud ps-new-study-modal" data-new-study-target="modal">
  <div class="ps-modal" role="dialog" aria-modal="true" aria-labelledby="new-study-title">
    <h2>New study</h2>
    <div class="title" id="new-study-title">What shall we call it?</div>

    <%= form_with url: studies_path, method: :post do %>
      <label class="field-label" for="new_study_name">Title</label>
      <%= text_field_tag :name, "Untitled Study", id: "new_study_name", class: "field", autocomplete: "off",
            data: { new_study_target: "name" } %>
      <%# One passage to start; Compare adds side-by-side panes any time. %>
      <%= hidden_field_tag :pane_count, 1, data: { new_study_target: "count" } %>

      <div class="actions">
        <button type="button" class="btn secondary" data-action="new-study#close">Cancel</button>
        <%= submit_tag "Create study", class: "btn primary" %>
      </div>
    <% end %>
  </div>
</div>
