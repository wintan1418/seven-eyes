<%# Preach / projector / stage chrome — moved here verbatim from show.html.erb.
    Every hook in this file is part of the preach contract
    (test/integration/preach_contract_test.rb): pastors drive it live. %>
  <button type="button" class="ps-exit-presentation" data-action="presentation#exit"
          title="Leave (Esc)">
    <span>&#10005;</span> Exit <span class="kbd">Esc</span>
  </button>
  <button type="button" class="ps-preach-enter" data-action="presentation#enterPreach"
          title="Preach mode — verse by verse, tap/swipe to advance">
    &#128272; Preach Mode
  </button>
  <button type="button" class="ps-preach-zone left"
          data-action="presentation#prev" aria-label="Previous verse" tabindex="-1"></button>
  <button type="button" class="ps-preach-zone right"
          data-action="presentation#next" aria-label="Next verse" tabindex="-1"></button>

  <button type="button" class="ps-preach-nav prev"
          data-action="presentation#prev" aria-label="Previous verse">&#8249;</button>
  <button type="button" class="ps-preach-nav next"
          data-action="presentation#next" aria-label="Next verse">&#8250;</button>

  <%# The preach toolbar. Focus view: one bar along the bottom, as always.
      Console view (console.css): the same bar runs along the top, in groups —
      what's on the screen · moving through it · the screen itself · other
      screens · help — and the "show" group (verses per slide, teaching text,
      parallel, split, emphasise) sits under the Live miniature. Every hook,
      action and target here is part of the preach contract. %>
  <div class="ps-preach-bar">
    <div class="ps-preach-bar-left">
      <%# Console: what the room sees, in one word (console_live_controller). %>
      <div class="cx-state" data-cx-state="live" role="status" aria-live="polite">
        <span class="cx-state-word" data-cx-state-word>Live</span>
        <span class="cx-state-what" data-cx-state-label>Nothing on the screen yet</span>
      </div>
      <div class="ps-preach-counter" data-preach-counter>
        <span class="num">verse 1</span>
      </div>
      <span class="ps-preach-live" title="The output window is live on the second screen">&#9679; Live</span>
      <span class="ps-live-chip" data-live-target="chip" title="Phones following along right now">
        <span class="dot" aria-hidden="true"></span>
        <span data-live-target="count">0</span>&nbsp;following
      </span>
      <%# Whether this study's Bibles are on the device (preach_offline_controller
          downloads them for signed-in presenters on entering preach). %>
      <button type="button" class="ps-preach-offline" hidden data-state="checking"
              data-controller="preach-offline" data-action="preach-offline#download"
              data-preach-offline>
        <span data-preach-offline-target="label">Checking offline&hellip;</span>
      </button>
    </div>
    <div class="ps-preach-bar-center">
      <%# Console: Preview → Live, the one button that changes the big screen. %>
      <div class="ps-bar-group is-golive" data-bar-group="golive">
        <button type="button" class="ps-preach-tool cx-golive" data-cx-golive disabled
                data-action="preview#goLive"
                title="Put what's in Preview on the big screen (L)"><span class="ic">&#9654;</span><span class="lbl">Go live</span><kbd>L</kbd></button>
      </div>
      <div class="ps-bar-group is-show" data-bar-group="show" role="group" aria-label="How the scripture shows">
        <div class="ps-preach-group">
          <span class="lbl">Group</span>
          <% (1..3).each do |n| %>
            <button type="button"
                    class="<%= 'is-on' if n == 1 %>"
                    data-action="presentation#setGroup"
                    data-preach-group="<%= n %>"
                    data-presentation-size-param="<%= n %>"
                    title="<%= n %> verse#{'s' if n > 1} per slide"><%= n %></button>
          <% end %>
        </div>
        <div class="ps-preach-group ps-preach-anchor">
          <span class="lbl">Text</span>
          <button type="button" data-preach-anchor-pin
                  data-action="presentation#pinAnchor"
                  title="Anchor the passage on screen as your main teaching text">&#9875;</button>
          <button type="button" data-preach-anchor-home disabled
                  data-action="presentation#goAnchor"
                  title="Pin a passage as your teaching text first">&#8962;</button>
        </div>
        <button type="button" class="ps-preach-tool"
                data-preach-parallel
                data-action="presentation#toggleParallel"
                title="Show two translations side-by-side (P)"><span class="ic">&#9783;</span><span class="lbl">Parallel</span></button>
        <button type="button" class="ps-preach-tool"
                data-preach-split
                data-action="presentation#toggleSplit"
                title="Divide the screen and show different scriptures side-by-side — click a region (or press 1–4) to make it active, then Go/Next move that side"><span class="ic">&#9707;</span><span class="lbl">Split</span></button>
        <button type="button" class="ps-preach-tool"
                data-preach-emph
                data-action="presentation#toggleEmphasis"
                title="Emphasise the minister's key word — tap words on the verse to make them glow on screen"><span class="ic">&#10038;</span><span class="lbl">Emphasise</span></button>
        <button type="button" class="ps-preach-tool" data-root-words-open="live"
                title="Root word — the Hebrew or Greek behind a word of this verse, on the screen (W)"><span class="ic">&#8501;</span><span class="lbl">Root word</span></button>
      </div>
      <div class="ps-bar-group is-move" data-bar-group="move">
        <button type="button" class="ps-preach-tool" disabled
                data-preach-back
                data-action="presentation#goBack"
                title="Back to where you were — the previous scripture or song (B)"><span class="ic">&#10558;</span><span class="lbl">Back</span></button>
        <button type="button" class="ps-preach-tool cx-focus-only"
                data-action="setlist#toggle"
                title="The preach queue — scriptures, songs and thoughts lined up for the service, with Preview (Q)"><span class="ic">&#9835;</span><span class="lbl">Queue</span></button>
        <button type="button" class="ps-preach-tool cx-focus-only"
                data-action="presentation#openJump"
                title="Go to a verse, chase any reference the preacher calls (rom 8:28), or describe a thought for AI search (G or /)"><span class="ic">&#10148;</span><span class="lbl">Go to verse</span></button>
      </div>
      <%# Black / Clear / Logo / Timer / Alert are the live toolbar (screen_live) at
          the right of the bar; the console lines them up after this group. %>
      <div class="ps-bar-group is-screen" data-bar-group="screen" role="group" aria-label="The big screen">
        <button type="button" class="ps-preach-tool"
                data-action="presentation#toggleScreenPanel"
                title="Looks — slide templates, background, Fade or Cut, logo and text size"><span class="ic">&#10022;</span><span class="lbl">Looks</span></button>
      </div>
      <div class="ps-bar-group is-outputs" data-bar-group="outputs" role="group" aria-label="Other screens">
        <button type="button" class="ps-preach-tool"
                data-preach-project
                data-action="presentation#openOutput"
                title="Open the output window — drag it onto the projector screen, then click Fullscreen"><span class="ic">&#10697;</span><span class="lbl">Project</span></button>
        <button type="button" class="ps-preach-tool"
                data-action="presentation#openStage"
                title="Stage display for the pulpit — current verse, NEXT verse big, and a clock"><span class="ic">&#8983;</span><span class="lbl">Stage</span></button>
        <button type="button" class="ps-preach-tool ps-golive"
                data-live-target="button"
                data-action="live#toggle"
                title="Go Live on phones — the congregation follows along, no account needed"><span class="ic">&#9737;</span><span class="lbl"><span class="cx-focus-only">Go Live</span><span class="cx-console-only">Phones</span></span></button>
        <button type="button" class="ps-preach-tool"
                data-remote-target="button"
                data-action="remote#toggle"
                title="Pair a phone as a remote clicker — next, previous, chase"><span class="ic">&#9742;</span><span class="lbl">Remote</span></button>
      </div>
      <div class="ps-bar-group is-help" data-bar-group="help">
        <button type="button" class="ps-preach-tool"
                data-action="presentation#toggleKeys"
                title="Keyboard shortcuts (?)"><span class="ic">&#9000;</span><span class="lbl">Keys</span></button>
        <button type="button" class="ps-preach-tool cx-console-only"
                data-action="console#tour"
                title="A one-minute tour of the console"><span class="ic">?</span><span class="lbl">Tour</span></button>
        <%# Console ⇄ Focus (the full-screen slide), remembered on this device (F). %>
        <button type="button" class="ps-preach-tool cx-view-toggle" data-cx-view-toggle
                data-action="console#toggleView" aria-pressed="false"
                title="Switch between the console and the full-screen slide (F)"><span class="ic">&#10530;</span><span class="lbl" data-cx-view-label>Focus</span></button>
      </div>
    </div>
    <div class="ps-preach-bar-right">
      <%# Live screen controls — one self-contained toolbar component
          (screen_live_controller): the buttons, the "what the room sees"
          badge and the Timer / Alert popovers travel together. %>
      <div class="ps-live-toolbar" data-controller="screen-live">
        <div class="ps-live-controls" role="group" aria-label="Big screen">
          <button type="button" class="ps-live-btn is-black" data-preach-blank aria-pressed="false"
                  data-action="presentation#toggleBlank"
                  title="Black — the screen goes fully black; press again to bring it back (. key)">
            <span class="ic" aria-hidden="true">&#9632;</span><span class="lbl">Black</span><kbd>.</kbd></button>
          <button type="button" class="ps-live-btn is-clear" aria-pressed="false"
                  data-screen-live-target="clearButton" data-action="screen-live#clear"
                  title="Clear — hide the words, keep the background, until the next slide (C)">
            <span class="ic" aria-hidden="true">&#9675;</span><span class="lbl">Clear</span><kbd>C</kbd></button>
          <button type="button" class="ps-live-btn is-logo" aria-pressed="false"
                  data-screen-live-target="logoButton" data-action="screen-live#logo"
                  title="Logo — your church logo or name on the background; press again to go back (O)">
            <span class="ic" aria-hidden="true">&#10022;</span><span class="lbl">Logo</span><kbd>O</kbd></button>
          <button type="button" class="ps-live-btn is-timer" aria-pressed="false"
                  data-screen-live-target="timerButton" data-action="screen-live#toggleTimer"
                  title="Countdown — &ldquo;Service starts in 04:59&rdquo; on the screen, then the logo (T)">
            <span class="ic" aria-hidden="true">&#9201;</span><span class="lbl">Timer</span><kbd>T</kbd></button>
          <button type="button" class="ps-live-btn is-alert" aria-pressed="false"
                  data-screen-live-target="alertButton" data-action="screen-live#toggleAlert"
                  title="Alert — a message across the bottom of the screen, over whatever is showing (A)">
            <span class="ic" aria-hidden="true">&#9888;</span><span class="lbl">Alert</span><kbd>A</kbd></button>
        </div>
        <%# What the room sees, in words — operator only (screen_live). %>
        <div class="ps-screen-state" data-screen-state hidden role="status" aria-live="polite"></div>

        <div class="ps-live-panel-pop" data-screen-live-target="timerPanel" hidden role="dialog" aria-label="Countdown">
          <div class="pp-head"><span>Countdown</span>
            <button type="button" class="close" data-action="screen-live#closePanels" aria-label="Close">&#10005;</button></div>
          <label>Heading <input type="text" maxlength="60" value="Service starts in" data-screen-live-target="heading"
                 data-action="keydown->screen-live#panelKey"></label>
          <div class="pp-row">
            <label>Minutes <input type="number" min="1" max="600" step="1" value="5" inputmode="numeric"
                   data-screen-live-target="minutes" data-action="keydown->screen-live#panelKey"></label>
            <span class="or">or until</span>
            <label>Time <input type="time" data-screen-live-target="until" data-action="keydown->screen-live#panelKey"></label>
          </div>
          <p class="pp-hint">Shows on the screen in your look. At 00:00 the logo comes up.</p>
          <button type="button" class="pp-go" data-action="screen-live#startCountdown">Start countdown</button>
        </div>

        <div class="ps-live-panel-pop" data-screen-live-target="alertPanel" hidden role="dialog" aria-label="Alert">
          <div class="pp-head"><span>Alert</span>
            <button type="button" class="close" data-action="screen-live#closePanels" aria-label="Close">&#10005;</button></div>
          <label>Message <input type="text" maxlength="160" placeholder="Parent of child 12, please come to the nursery"
                 data-screen-live-target="alertText" data-action="keydown->screen-live#panelKey"></label>
          <label>Hide it
            <select data-screen-live-target="alertSeconds">
              <option value="0">when I dismiss it</option>
              <option value="15">after 15 seconds</option>
              <option value="30" selected>after 30 seconds</option>
              <option value="60">after 1 minute</option>
              <option value="120">after 2 minutes</option>
            </select>
          </label>
          <p class="pp-hint">Runs across the bottom of the screen, over whatever is showing.</p>
          <div class="pp-row">
            <button type="button" class="pp-go" data-action="screen-live#showAlert">Show alert</button>
            <button type="button" class="pp-quiet" data-action="screen-live#dismissAlert">Dismiss</button>
          </div>
        </div>
      </div>
      <button type="button" class="ps-preach-tool"
              data-action="presentation#prev" title="Previous verse (←)"><span class="ic">&#8249;</span><span class="lbl">Prev</span></button>
      <button type="button" class="ps-preach-tool primary"
              data-action="presentation#next" title="Next verse (→ or Space)"><span class="lbl">Next</span><span class="ic">&#8250;</span></button>
    </div>
  </div>

  <div class="ps-preach-next" data-preach-next aria-hidden="true"></div>

  <%# Reference banner — so the congregation sees "John 3:16 · KJV", not just "16" %>
  <div class="ps-preach-ref" data-preach-ref aria-hidden="true"></div>

  <button type="button" class="ps-out-full" data-action="presentation#toggleFullscreen"
          title="Fullscreen on this screen">&#9974; Fullscreen</button>

  <%# Content slide layer — a song stanza or thought projected instead of the verse %>
  <div class="ps-preach-slide" data-preach-slide></div>

  <%# Holding / blank screen — snaps the projector to a calm hold between segments %>
  <div class="ps-preach-hold" data-preach-hold aria-hidden="true">
    <span class="orn">&#10022;</span>
  </div>

  <%# The look's background (custom picture / video inside) and the full-screen
      logo, countdown and alert layers (screen_look / screen_live; slide_themes.css). %>
  <div class="ps-look-bg" data-look-bg aria-hidden="true"></div>
  <div class="ps-screen-logo" data-screen-logo aria-hidden="true"></div>
  <div class="ps-screen-countdown" data-screen-countdown aria-hidden="true">
    <div class="cd-head"></div>
    <div class="cd-digits"></div>
  </div>
  <div class="ps-screen-alert" data-screen-alert hidden>
    <span class="al-text"></span>
  </div>

  <%# Go-Live join card on the projector — QR + code for the whole room to scan %>
  <div class="ps-preach-join" data-preach-join hidden></div>

  <%# AI quick-search results for the Go box ("the walls of jericho" → chips) %>
  <div class="ps-preach-finds" data-preach-finds hidden></div>

  <%# Looks — the projection's slide template, background, Fade/Cut, logo slide
      and text size (screen_look_controller + lib/slide_themes; drawn by
      slide_themes.css). Scale/weight stay with presentation#bumpScale/setWeight. %>
  <div class="ps-screen-panel ps-looks" hidden data-controller="screen-look" role="dialog" aria-label="Looks">
    <div class="lk-head">
      <div>
        <div class="lbl">Looks</div>
        <div class="sub">How the big screen looks &mdash; kept for this study and as your default.</div>
      </div>
      <button type="button" class="done" data-action="presentation#toggleScreenPanel">Done</button>
    </div>
    <div class="lk-body">
      <div class="lk-grid" data-screen-look-target="grid" role="radiogroup" aria-label="Slide looks"></div>
      <div class="lk-side">
        <div class="ps-look-preview" data-screen-look-target="preview" aria-hidden="true">
          <span class="lp-bg"></span>
          <span class="lp-text">For God so loved the world, that he gave his only begotten Son</span>
          <span class="lp-ref">John 3:16</span>
          <span class="lp-name"></span>
        </div>

        <div class="lk-label">Background</div>
        <div class="row seg">
          <button type="button" data-bg="look" data-screen-look-target="bgButton" data-action="screen-look#setBg">The look&rsquo;s</button>
          <button type="button" data-bg="image" data-screen-look-target="bgButton" data-action="screen-look#setBg">My picture</button>
          <button type="button" data-bg="video" data-screen-look-target="bgButton" data-action="screen-look#setBg">My video</button>
        </div>
        <div class="row files">
          <label class="file">Choose picture&hellip;
            <input type="file" accept="image/*" data-slot="image" data-action="change->screen-look#upload"></label>
          <label class="file">Choose video&hellip;
            <input type="file" accept="video/mp4,video/webm,video/*" data-slot="video" data-action="change->screen-look#upload"></label>
        </div>
        <label class="row dim">Darken it
          <input type="range" min="0" max="0.8" step="0.05" value="0.35" data-screen-look-target="dim"
                 data-action="input->screen-look#setDim"></label>
        <p class="lk-note" data-screen-look-target="note" aria-live="polite"></p>

        <div class="lk-label">Changing slides</div>
        <div class="row seg">
          <button type="button" data-transition="fade" data-screen-look-target="transitionButton" data-action="screen-look#setTransition">Fade</button>
          <button type="button" data-transition="cut" data-screen-look-target="transitionButton" data-action="screen-look#setTransition">Cut</button>
        </div>

        <div class="lk-label">Text</div>
        <div class="row scale">
          <button type="button" data-screen-scale-delta="-0.1" data-action="presentation#bumpScale">A&minus;</button>
          <span class="val" data-screen-scale>100%</span>
          <button type="button" data-screen-scale-delta="0.1" data-action="presentation#bumpScale">A&#43;</button>
        </div>
        <div class="row weights">
          <button type="button" data-screen-weight="regular" data-action="presentation#setWeight">Regular</button>
          <button type="button" data-screen-weight="bold" data-action="presentation#setWeight"><b>Bold</b></button>
        </div>

        <div class="lk-label">Logo slide</div>
        <div class="row brand">
          <span class="logo-thumb" data-screen-look-target="logoThumb"></span>
          <label class="file">Choose logo&hellip;
            <input type="file" accept="image/*" data-slot="logo" data-action="change->screen-look#upload"></label>
          <button type="button" class="quiet" data-slot="logo" data-action="screen-look#removeMedia">Remove</button>
        </div>
        <input type="text" class="lk-input" maxlength="80" placeholder="Church name" aria-label="Church name"
               data-screen-look-target="brandName" data-action="input->screen-look#setBrand">
        <input type="text" class="lk-input" maxlength="120" placeholder="Welcome line (optional)" aria-label="Welcome line"
               data-screen-look-target="brandLine" data-action="input->screen-look#setBrand">
        <p class="hint">Text fills the screen automatically. A&minus; / A&#43; set the most it may grow. Pictures,
          video and logo stay on this computer, so they work offline.</p>
      </div>
    </div>
    <%# The older Vellum / Ink / Paper setting, kept in step by screen-look. %>
    <div class="lk-legacy" hidden>
      <button type="button" data-screen-theme="vellum" data-action="presentation#setTheme">Vellum</button>
      <button type="button" data-screen-theme="ink" data-action="presentation#setTheme">Ink</button>
      <button type="button" data-screen-theme="paper" data-action="presentation#setTheme">Paper</button>
    </div>
  </div>

  <%# Stage display (?stage=1): NOW small, NEXT big, clock — for the pulpit %>
  <div class="ps-stage" aria-hidden="true">
    <div class="ps-stage-head">
      <span class="ref" data-stage-ref></span>
      <span class="clock" data-stage-clock></span>
    </div>
    <div class="ps-stage-now" data-stage-now></div>
    <div class="ps-stage-next" data-stage-next></div>
  </div>

  <%# The preach keyboard, one card ("?" or ⌨ Keys). Operator only. %>
  <div class="ps-preach-keys" data-preach-keys hidden role="dialog" aria-label="Keyboard shortcuts">
    <div class="head">
      <span>Keyboard shortcuts</span>
      <button type="button" class="close" data-action="presentation#toggleKeys" aria-label="Close">&#10005;</button>
    </div>
    <div class="cols">
      <dl>
        <dt>On screen</dt>
        <div><dd><kbd>&rarr;</kbd> <kbd>Space</kbd></dd><dd>Next verse</dd></div>
        <div><dd><kbd>&larr;</kbd></dd><dd>Previous verse</dd></div>
        <div><dd><kbd>G</kbd> <kbd>/</kbd></dd><dd>Go to a verse / reference (<kbd>Enter</kbd> live, <kbd>Shift</kbd>+<kbd>Enter</kbd> Preview). Words search the Scriptures. In the console: the library&rsquo;s box (<kbd>Enter</kbd> Preview, <kbd>Shift</kbd>+<kbd>Enter</kbd> live).</dd></div>
        <div><dd><kbd>F</kbd></dd><dd>Console &#8644; Focus (the full-screen slide)</dd></div>
        <div><dd><kbd>1</kbd>&ndash;<kbd>3</kbd></dd><dd>Verses per slide</dd></div>
        <div><dd><kbd>B</kbd></dd><dd>Back to where you were</dd></div>
        <div><dd><kbd>H</kbd></dd><dd>Home to the teaching text</dd></div>
        <div><dd><kbd>P</kbd></dd><dd>Parallel translations</dd></div>
        <div><dd><kbd>.</kbd></dd><dd>Black &mdash; the screen fully black</dd></div>
        <div><dd><kbd>W</kbd></dd><dd>Root word (Hebrew / Greek) of the verse on screen &mdash; <kbd>Shift</kbd>+<kbd>W</kbd> for Preview</dd></div>
        <div><dd><kbd>C</kbd></dd><dd>Clear &mdash; hide the words, keep the background</dd></div>
        <div><dd><kbd>O</kbd></dd><dd>Logo on the screen</dd></div>
        <div><dd><kbd>T</kbd></dd><dd>Countdown timer</dd></div>
        <div><dd><kbd>A</kbd></dd><dd>Alert across the bottom of the screen</dd></div>
        <div><dd><kbd>Esc</kbd></dd><dd>Close / leave preach (twice while projecting)</dd></div>
      </dl>
      <dl>
        <dt>Queue &amp; Preview</dt>
        <div><dd><kbd>Q</kbd></dd><dd>Into the queue</dd></div>
        <div><dd><kbd>&uarr;</kbd> <kbd>&darr;</kbd></dd><dd>Pick a queue item</dd></div>
        <div><dd><kbd>Enter</kbd></dd><dd>Preview it &mdash; again to go live</dd></div>
        <div><dd><kbd>N</kbd></dd><dd>Preview the next queue item</dd></div>
        <div><dd><kbd>L</kbd></dd><dd>Go live with what&rsquo;s in Preview</dd></div>
        <div><dd><kbd>Alt</kbd>+<kbd>&uarr;</kbd> <kbd>&darr;</kbd></dd><dd>Move the item up / down</dd></div>
        <div><dd><kbd>Delete</kbd></dd><dd>Remove it (<kbd>U</kbd> undoes)</dd></div>
        <div><dd><kbd>E</kbd></dd><dd>Edit it</dd></div>
        <div><dd><kbd>A</kbd></dd><dd>Type new items to add</dd></div>
        <div><dd><kbd>?</kbd></dd><dd>This card</dd></div>
      </dl>
      <dl>
        <dt>Search results (results go to Preview)</dt>
        <div><dd><kbd>&uarr;</kbd> <kbd>&darr;</kbd></dd><dd>Move through the results</dd></div>
        <div><dd><kbd>Enter</kbd> / click</dd><dd>Preview it &mdash; the screen doesn&rsquo;t change</dd></div>
        <div><dd><kbd>L</kbd></dd><dd>Go live with what&rsquo;s in Preview</dd></div>
        <div><dd><kbd>Shift</kbd>+<kbd>Enter</kbd></dd><dd>Put the result straight on the screen (or double-click, or its Go live)</dd></div>
        <div><dd><kbd>+</kbd></dd><dd>Add it to the queue</dd></div>
        <div><dd><kbd>Esc</kbd></dd><dd>Close the results</dd></div>
      </dl>
    </div>
  </div>

  <div class="ps-preach-jump" hidden>
    <span>Go to</span>
    <input type="text" inputmode="search" placeholder="jn 3 16 &middot; 28 &middot; or a phrase"
           autocomplete="off" spellcheck="false" autocapitalize="none"
           data-presentation-target="jumpInput"
           data-action="input->presentation#jumpPreview keydown.enter->presentation#jumpSubmit keydown.shift+enter->presentation#jumpPreviewSubmit keydown.esc->presentation#cancelJump">
    <button type="button" data-action="presentation#jumpSubmit">Go</button>
    <button type="button" class="ps-preach-jump-preview" data-action="presentation#jumpPreviewSubmit"
            title="Load it into Preview — the projector doesn't change until you Go live (Shift+Enter)">Preview</button>
    <%# Opt-in: Enter previews instead of going straight to the screen. %>
    <button type="button" class="ps-preach-jump-mode" data-preview-first aria-pressed="false"
            data-action="preview#togglePreviewFirst"
            title="When on, Enter loads Preview instead of the projector">Preview first</button>
    <%# What Enter will do, live as you type: "→ John 3:16", "Verse 28", or an AI search. %>
    <span class="ps-preach-jump-hint" data-presentation-target="jumpHint" aria-live="polite">Type a reference, a verse number, or describe a passage</span>
  </div>
