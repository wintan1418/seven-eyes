<% content_for :title, "BiblioRata — The Word, Laid Open · Bible Reader, Study & Live Projection" %>
<% content_for :head do %>
  <meta name="description" content="A calm, free Bible reader for pastors and serious readers. Compare public-domain translations side by side, follow 343,000+ cross-references, and carry the same passage into the pulpit — live projection your congregation follows on their phones. No account needed.">
<% end %>
<% vod_text = @verse_of_day&.text || "Open thou mine eyes, that I may behold wondrous things out of thy law." %>
<% vod_ref = @verse_of_day ? @verse_of_day.reference_label : "Psalm 119:18" %>
<% vod_trans = @verse_of_day ? @verse_of_day.translation_code : "KJV" %>

<div class="ld-page ps-landing">
  <header class="ui-appbar ld-appbar ld-nav">
    <div class="ui-appbar-start">
      <%= link_to root_path, class: "ui-brand" do %>
        <span class="ui-brand-mark" aria-hidden="true"><%= icon(:book) %></span>
        <span class="ui-brand-name">BiblioRata</span>
      <% end %>
    </div>
    <div class="ui-appbar-center"></div>
    <nav class="ui-appbar-end ld-nav-links" aria-label="Site">
      <%= link_to "Guide", guide_path, class: "ui-btn is-sm is-quiet ld-hide-sm" %>
      <%= link_to "Sign in", new_session_path, class: "ui-btn is-sm is-quiet" %>
      <%= link_to "Create account", new_registration_path, class: "ui-btn is-sm is-primary" %>
    </nav>
  </header>

  <main>
    <section class="ld-hero">
      <p class="ld-eyebrow">Free &middot; no account needed</p>
      <h1>The Word, laid open.</h1>
      <p class="ld-lede">
        A calm Bible reader for study and for the pulpit. Read any passage, compare translations
        side by side, trace cross-references &mdash; and on Sunday, put it on the screen while your
        congregation follows on their phones.
      </p>

      <%= form_with url: studies_path, method: :post, class: "ps-quick-open ld-search" do %>
        <%= icon(:search) %>
        <%= text_field_tag :reference, nil, class: "ld-search-input", autocomplete: "off",
              spellcheck: "false", autocapitalize: "none", inputmode: "search", enterkeyhint: "go",
              placeholder: "John 3:16, Psalm 23, rom 8…", "aria-label": "Open a passage" %>
        <%= hidden_field_tag :pane_count, 1 %>
        <button type="submit" class="ui-btn is-accent ld-search-go">Read</button>
      <% end %>
      <div class="ld-quick">
        <span>Try</span>
        <% [ "John 1", "Psalm 23", "Romans 8", "Isaiah 40" ].each do |ref| %>
          <%= button_to ref, studies_path, params: { reference: ref, pane_count: 1 }, class: "ui-pill", form: { class: "contents" } %>
        <% end %>
      </div>
    </section>

    <section class="ld-vod" aria-labelledby="vod-title">
      <div class="ld-vod-card">
        <div class="ui-label" id="vod-title">Verse of the day</div>
        <blockquote class="ld-vod-text"><%= vod_text %></blockquote>
        <div class="ld-vod-foot">
          <span class="ld-vod-ref"><%= vod_ref %> &middot; <%= vod_trans %></span>
          <%= button_to studies_path, params: { reference: vod_ref, pane_count: 1 }, class: "ui-btn is-sm", form: { class: "contents" } do %>
            Read the chapter <%= icon(:chevron_right) %>
          <% end %>
        </div>
      </div>
    </section>

    <section class="ld-features" aria-label="What you can do">
      <article class="ld-feature">
        <div class="ld-feature-icon"><%= icon(:book) %></div>
        <div>
          <h2>Read comfortably</h2>
          <p>One clean column of Scripture with the book and chapter a tap away. Light, sepia or dark, the text size you like, and it&rsquo;s just as good on your phone.</p>
        </div>
      </article>
      <article class="ld-feature">
        <div class="ld-feature-icon"><%= icon(:columns) %></div>
        <div>
          <h2>Study deeply</h2>
          <p>Compare up to four translations side by side, follow <%= number_with_delimiter(@canon_stats[:cross_references]) %> cross-references, look up the Hebrew and Greek, and keep notes and highlights.</p>
        </div>
      </article>
      <article class="ld-feature">
        <div class="ld-feature-icon"><%= icon(:presentation) %></div>
        <div>
          <h2>Preach with it</h2>
          <p>Project verse by verse, chase any reference the preacher calls, let the congregation follow live on their phones, and drive it all from a phone remote.</p>
        </div>
      </article>
    </section>

    <% if @testimonials.present? %>
      <section class="ld-voices" aria-labelledby="voices-title">
        <h2 id="voices-title">From fellow readers</h2>
        <div class="ld-voices-grid">
          <% @testimonials.each do |t| %>
            <figure class="ld-voice">
              <blockquote>&ldquo;<%= t.best_line.presence || truncate(t.body, length: 160) %>&rdquo;</blockquote>
              <figcaption>
                <span class="ld-voice-avatar" aria-hidden="true"><%= (t.name.presence || "A").strip[0].upcase %></span>
                <span>
                  <span class="who"><%= t.name.presence || "A reader" %></span>
                  <% if t.title_company.present? %><span class="role"><%= t.title_company %></span><% end %>
                </span>
              </figcaption>
            </figure>
          <% end %>
        </div>
        <p class="ld-voices-cta"><%= link_to "Share how BiblioRata helps you", "/testimonials/new" %></p>
      </section>
    <% else %>
      <p class="ld-voices-cta ld-voices-invite">
        Has BiblioRata helped your study or your Sunday? <%= link_to "Tell us in a line", "/testimonials/new" %>
      </p>
    <% end %>

    <section class="ld-stats ps-canon-stats" aria-label="On our own shelves">
      <span><b><%= @canon_stats[:translations] %></b> translations</span>
      <span><b><%= number_with_delimiter(@canon_stats[:verses]) %></b> verses</span>
      <span><b><%= number_with_delimiter(@canon_stats[:cross_references]) %></b> cross-references</span>
      <span>all public domain, served from our own shelves</span>
    </section>
  </main>

  <footer class="ld-footer ld-foot">
    <div class="ld-footer-brand">
      <span class="ui-brand-mark" aria-hidden="true"><%= icon(:book) %></span> BiblioRata
    </div>
    <nav class="ld-foot-links" aria-label="Footer">
      <%= link_to "Guide", guide_path %>
      <%= link_to "What's new", whats_new_path %>
      <%= link_to "Sign in", new_session_path %>
      <%= link_to "Create account", new_registration_path %>
      <a href="/testimonials/new">Leave a testimonial</a>
      <%= link_to "Terms", terms_path %>
      <%= link_to "Privacy", privacy_path %>
      <%= link_to "Credits", credits_path %>
    </nav>
  </footer>
</div>
