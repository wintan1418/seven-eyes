<%# A discovery panel: "What's at your desk." Headline = Reading Plans, then 9
     compact cards introducing the other tools. Signed-in users can hide it
     (persisted on the user) and bring it back from the ☰ menu. %>
<section class="ps-guide" data-controller="guide">
  <header class="ps-guide-head">
    <div>
      <div class="ps-guide-eyebrow">A Quill &amp; Compass</div>
      <h2 class="ps-guide-title">What's at your desk</h2>
      <p class="ps-guide-sub">A guide to the tools — bring it back any time from the ☰ menu.</p>
    </div>
    <% if authenticated? %>
      <%= button_to "Hide", dismiss_guide_path, method: :post, class: "ui-btn is-sm ps-guide-hide", form: { class: "contents" } %>
    <% end %>
  </header>

  <div class="ps-guide-grid">
    <%# headline card: reading plans %>
    <a class="ps-guide-card ps-guide-card-lg" href="<%= authenticated? ? reading_plans_path : new_session_path %>">
      <span class="orn">&#10070;</span>
      <span class="t">Reading Plans</span>
      <span class="d">Build a custom plan — pace a single book, the whole NT, the year-long Bible, or your own path — and tick each day done. The manuscript calendar fills as you go.</span>
      <span class="cta">Open Plans &rsaquo;</span>
    </a>

    <div class="ps-guide-card">
      <span class="orn">&#10086;</span>
      <span class="t">Parallel translations</span>
      <span class="d">Read up to 4 versions of the same passage side by side. Tap <strong>Compare</strong> in the top bar, or Compare on any verse.</span>
    </div>

    <div class="ps-guide-card">
      <span class="orn">&#8501;</span>
      <span class="t">Word study (Strong's)</span>
      <span class="d">Turn on <strong>Word study</strong> in reading settings (or a verse's More menu), then tap a King James word for its Greek or Hebrew root, definition and every occurrence.</span>
    </div>

    <div class="ps-guide-card">
      <span class="orn">&#167;</span>
      <span class="t">Cross references</span>
      <span class="d">Tap a verse, then <strong>More → Cross-references</strong> for the related passages, strongest first. Open any of them with one tap.</span>
    </div>

    <div class="ps-guide-card">
      <span class="orn">&#128220;</span>
      <span class="t">Matthew Henry commentary</span>
      <span class="d">Tap a verse, then <strong>More → Commentary</strong> to read the chapter's exposition beside the text.</span>
    </div>

    <div class="ps-guide-card">
      <span class="orn">&#9906;</span>
      <span class="t">Full-Bible search</span>
      <span class="d">Type a phrase like "love your enemies" and jump straight to it. The search button sits in the top bar.</span>
    </div>

    <div class="ps-guide-card">
      <span class="orn">&#10038;</span>
      <span class="t">AI "Find a verse"</span>
      <span class="d">Describe a thought — "where Paul says we're saved by grace, not by works" — and the assistant suggests passages, validated against our text.</span>
    </div>

    <div class="ps-guide-card">
      <span class="orn">&#10018;</span>
      <span class="t">Ask the AI Rabbi</span>
      <span class="d">Select a phrase or tap a verse, choose <em>Rabbi</em>, and it explains the words in the light of the whole chapter and its cross-references — careful, in-context, never beyond Scripture.</span>
    </div>

    <div class="ps-guide-card">
      <span class="orn">&#9658;</span>
      <span class="t">Read aloud</span>
      <span class="d">Tap the headphones under the chapter title to hear the passage read aloud; tap again to stop.</span>
    </div>

    <div class="ps-guide-card">
      <span class="orn">&#9680;</span>
      <span class="t">Memorize mode</span>
      <span class="d">The eye icon under the chapter title blanks out the words; tap each blank to reveal it. Great for memory drills.</span>
    </div>

    <div class="ps-guide-card">
      <span class="orn">&#9998;</span>
      <span class="t">Highlights with notes</span>
      <span class="d">Tap a verse (or select a phrase), pick a colour, and add a note. A small ✎ marks highlights that carry a note.</span>
    </div>
  </div>

  <div class="ps-guide-foot">
    <%= link_to "Open the full illustrated guide ›", guide_path, class: "ps-guide-foot-link" %>
    <span class="ps-guide-foot-note">A quick tour also greets you the first time you open a study.</span>
  </div>
</section>
