<div class="ps-root" data-controller="new-study">
  <%= render "topbar", study_name: "The Scriptorium", panes: 4, sync: false, saved: true %>
  <div class="ps-shell">
    <%= render "sidebar", studies: @studies %>
    <main class="ps-workspace is-doc" style="grid-template-columns: 1fr;">
      <div class="ps-welcome ps-welcome--grand">
        <span class="float-orn fo1" aria-hidden="true">&#10038;</span>
        <span class="float-orn fo2" aria-hidden="true">&#10086;</span>
        <span class="float-orn fo3" aria-hidden="true">&#10070;</span>
        <span class="float-orn fo4" aria-hidden="true">&#9769;</span>
        <span class="float-orn fo5" aria-hidden="true">&#10087;</span>
        <div class="eyebrow rise">&#9769; &nbsp; A Quiet Desk For The Word &nbsp; &#9769;</div>
        <% if authenticated? %>
          <h1 class="rise"><span class="h1dc">W</span>elcome back.</h1>
        <% else %>
          <h1 class="rise"><span class="h1dc">P</span>arallel Scripture</h1>
        <% end %>
        <svg class="ps-flourish rise" viewBox="0 0 260 34" width="260" height="34" aria-hidden="true">
          <path d="M6 22 C 40 2, 74 30, 104 20 S 150 4, 130 14 S 166 30, 196 16 C 220 6, 240 20, 254 12" />
          <path d="M118 26 c 6 -8, 18 -8, 24 0" />
        </svg>

        <%# Quick-open: type a reference, land in a fresh two-pane study. %>
        <%= form_with url: studies_path, method: :post, class: "ps-quick-open rise" do %>
          <span class="qo-orn">&#10038;</span>
          <%= text_field_tag :reference, nil, class: "qo-input", autocomplete: "off",
                spellcheck: "false", autocapitalize: "none", inputmode: "search", enterkeyhint: "go",
                placeholder: "Open the Word — try “John 3:16”, “Ps 23”, “rom 8”…",
                "aria-label": "Open a passage" %>
          <%= hidden_field_tag :pane_count, 2 %>
          <button type="submit" class="qo-go">Read</button>
        <% end %>
        <div class="qo-hint rise">One line opens a fresh side-by-side study &mdash; no account needed.</div>

        <%# The verse of the day as an illuminated plate. %>
        <% vod_text = @verse_of_day&.text || "Open thou mine eyes, that I may behold wondrous things out of thy law." %>
        <% vod_ref = @verse_of_day ? "#{@verse_of_day.reference_label} · #{@verse_of_day.translation_code}" : "Psalm 119:18 · KJV" %>
        <figure class="ps-illumined ps-illumined--folio rise">
          <span class="corner tl">&#10086;</span>
          <span class="corner tr">&#10086;</span>
          <span class="corner bl">&#10086;</span>
          <span class="corner br">&#10086;</span>
          <div class="plate-eyebrow">&#10022; &nbsp; Verse For The Day &nbsp; &#10022;</div>
          <blockquote><span class="dc"><%= vod_text.first %></span><%= vod_text[1..] %></blockquote>
          <figcaption><%= vod_ref %></figcaption>
          <span class="seal" aria-hidden="true">&#9769;</span>
        </figure>

        <div class="cta-row rise">
          <button type="button" class="cta" data-action="new-study#open">&#10010; &nbsp; Begin a New Study</button>
          <% if (resume = @studies.first) %>
            <%= link_to "↻  Resume #{truncate(resume.name, length: 28)}", study_path(resume),
                  class: "cta secondary", style: "text-decoration:none;" %>
          <% end %>
          <% if authenticated? %>
            <%= link_to "&#10070; Reading Plans".html_safe, reading_plans_path,
                  class: "cta secondary", style: "text-decoration:none;" %>
          <% end %>
        </div>

        <% if @active_plan && @plan_today %>
          <div class="ps-today-panel rise">
            <div class="ps-today-label">Today &middot; <%= @active_plan.name %> &middot; day <%= @plan_today.day_number %></div>
            <div class="ps-today-refs"><%= @plan_today.refs.presence || "No passages set for today." %></div>
            <div class="ps-today-cta">
              <% if @plan_today.refs.present? %>
                <%= link_to "Begin today's reading", open_today_reading_plan_path(@active_plan), class: "cta" %>
              <% end %>
              <%= link_to "Open plan", reading_plan_path(@active_plan), class: "cta secondary", style: "text-decoration:none;" %>
              <span class="ps-today-streak">streak <%= @active_plan.current_streak %></span>
            </div>
          </div>
        <% elsif authenticated? && @studies.empty? %>
          <%# gentle nudge for new users %>
          <div class="ps-today-panel ps-today-panel--soft rise">
            <div class="ps-today-label">A Daily Rhythm</div>
            <div class="ps-today-refs">Build a reading plan to keep your time in the Word steady — pace a single book, the whole New Testament, the year-long Bible, or your own custom path.</div>
            <div class="ps-today-cta">
              <%= link_to "Create a Reading Plan", new_reading_plan_path, class: "cta" %>
            </div>
          </div>
        <% end %>

        <% if authenticated? && @studies.present? %>
          <section class="ps-recent-shelf rise">
            <div class="shelf-head">
              <span class="line"></span>
              <span class="fl">&#10087;</span>
              <span class="t">Return To The Desk</span>
              <span class="fl">&#10087;</span>
              <span class="line"></span>
            </div>
            <div class="shelf-grid">
              <% @studies.first(6).each do |study| %>
                <%= link_to study_path(study), class: "ps-study-card" do %>
                  <span class="nm"><%= study.name %></span>
                  <% refs = study.panes.filter_map { |p| p.reference.presence } %>
                  <span class="refs"><%= refs.any? ? refs.first(3).join(" · ") : "An empty codex, awaiting ink" %></span>
                  <span class="meta"><%= %w[I II III IV][study.pane_count - 1] %> &middot; <%= pluralize(study.pane_count, "pane") %> &middot; <%= time_ago_in_words(study.last_opened_at || study.updated_at) %> ago</span>
                <% end %>
              <% end %>
            </div>
          </section>
        <% end %>

        <% if @show_guide %>
          <%= render "studies/guide" %>
        <% end %>

        <div class="ps-canon-stats rise">
          <span><b><%= @canon_stats[:translations] %></b> translations</span>
          <span class="sep">&middot;</span>
          <span><b><%= number_with_delimiter(@canon_stats[:verses]) %></b> verses</span>
          <span class="sep">&middot;</span>
          <span><b><%= number_with_delimiter(@canon_stats[:cross_references]) %></b> cross-references</span>
          <span class="sep">&middot;</span>
          <span>all seeded on this desk &mdash; no external APIs</span>
        </div>
      </div>
    </main>
  </div>
  <%= render "studies/new_study_modal" %>
</div>
