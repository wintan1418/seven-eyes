<% content_for :title, "Home · BiblioRata" %>
<%# Home: signed in, and app guests (inside the apps a signed-out Home tab is
    this page without the personal parts; website visitors get the landing).
    Top to bottom: greeting + search, the verse of the day over a painting,
    Continue reading + today's plan, quick actions, the glossary slider, your
    studies, a slim guide line and the footer. Styles: ui/home.css. %>
<% guest = @guest %>
<div class="ps-root hm-root<%= ' is-guest' if guest %>" data-controller="new-study">
  <%= render "studies/app_bar", title: "Home" %>
  <%= render "studies/menu_sheet", studies: @studies, new_study_modal: !guest %>

  <main class="hm-main">
    <div class="hm-page">
      <%= render "studies/home/hello", guest: %>

      <div class="hm-top">
        <%= render "studies/home/verse", word: @daily_word, art: @verse_art %>

        <div class="hm-side">
          <%= render "studies/home/resume", study: @resume, guest: %>
          <% if guest %>
            <%= render "studies/home/join" %>
          <% else %>
            <%= render "studies/home/plan", plan: @active_plan, progress: @plan_progress %>
          <% end %>
          <%= render "studies/home/actions", guest:, resume: @resume %>
        </div>
      </div>

      <% if @faith_term %>
        <div class="hm-block">
          <%= render "faith_terms/slider", terms: @faith_slides, roots: @faith_slide_roots, total: @faith_total,
                     everywhere: true, eager_first: false %>
        </div>
      <% end %>

      <% unless guest %>
        <%= render "studies/home/studies", studies: @studies %>
      <% end %>

      <% if @show_guide %>
        <%= render "studies/home/guide" %>
      <% end %>

      <footer class="hm-foot ps-canon-stats">
        <span><%= @canon_stats[:translations] %> translations</span> &middot;
        <span><%= number_with_delimiter(@canon_stats[:verses]) %> verses</span> &middot;
        <span><%= number_with_delimiter(@canon_stats[:cross_references]) %> cross-references</span>
        <span class="hm-foot-links">
          <%= link_to "Guide", guide_path %> &middot; <%= link_to "Terms", terms_path %> &middot;
          <%= link_to "Privacy", privacy_path %> &middot; <%= link_to "Credits", credits_path %>
        </span>
      </footer>
    </div>
  </main>
  <%= render "shared/tab_bar", current: :home %>
  <% unless guest %>
    <%= render "studies/new_study_modal" %>
  <% end %>
  <%# Outside .hm-main (its own stacking context), so the modal covers the app bar. %>
  <%= render "daily_words/share_modal", word: @daily_word if @daily_word %>
</div>
