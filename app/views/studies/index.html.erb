<% content_for :title, "Home · BiblioRata" %>
<%# Home: signed in, and app guests (inside the apps a signed-out Home tab is
    this page without the personal parts; website visitors get the landing).
    "The illuminated Bible": Today leads — the day's verse over a painting with
    one button into the guided daily flow (/today/begin) — then everything a
    swipe away: Continue, Words of the faith, For you, From fellow readers
    (testimonials), studies.
    Pastor mode puts This Sunday first. The page takes the hour's tint
    (data-daypart: dawn / day / evening) over whatever theme the reader chose.
    Styles: ui/home.css + ui/illuminated.css. %>
<% guest = @guest %>
<div class="ps-root hm-root<%= ' is-guest' if guest %><%= ' has-sunday' if @sunday %>" data-controller="new-study"
     data-daypart="<%= @daypart.key %>">
  <%= render "studies/app_bar", title: "Home" %>
  <%= render "studies/menu_sheet", studies: @studies, new_study_modal: !guest %>

  <main class="hm-main" data-controller="parallax" data-parallax-target="scroller">
    <div class="hm-glow" aria-hidden="true"></div>
    <div class="hm-lead">
      <% if @sunday %>
        <%= render "studies/home/sunday", sunday: @sunday %>
      <% end %>
      <%= render "studies/home/today", word: @daily_word, art: @verse_art, guest:, status: @today_status,
                 daypart: @daypart, fixed: @daypart_fixed %>
    </div>

    <div class="hm-page">
      <div class="hm-tools">
        <%= form_with url: search_path, method: :get, class: "hm-search", role: "search" do %>
          <%= icon(:search) %>
          <%= search_field_tag :q, nil, class: "hm-search-input", autocomplete: "off", spellcheck: "false",
                autocapitalize: "none", enterkeyhint: "search",
                placeholder: "Search the Bible or open John 3:16", "aria-label": "Search the Bible or open a passage" %>
        <% end %>
        <%= render "studies/home/actions", guest:, resume: @resume %>
      </div>

      <%= render "studies/home/continue", resume: @resume, guest:, plan: @active_plan, progress: @plan_progress,
                 studies: @studies %>

      <% if @faith_term %>
        <div class="hm-block">
          <%= render "faith_terms/slider", terms: @faith_slides, roots: @faith_slide_roots, total: @faith_total,
                     everywhere: true, eager_first: false, title: "Words of the faith" %>
        </div>
      <% end %>

      <% if @for_you.present? %>
        <%= render "studies/home/for_you", cards: @for_you %>
      <% end %>

      <% if @testimonials.present? %>
        <%= render "studies/home/voices", testimonials: @testimonials %>
      <% end %>

      <% unless guest %>
        <%= render "studies/home/studies", studies: @studies, skip: home_rail_studies(@studies, @resume) %>
      <% end %>

      <% if @show_guide %>
        <%= render "studies/home/guide" %>
      <% end %>

      <footer class="hm-foot ps-canon-stats">
        <span class="hm-foot-mark" aria-hidden="true">✠</span>
        <span><%= @canon_stats[:translations] %> translations</span> &middot;
        <span><%= number_with_delimiter(@canon_stats[:verses]) %> verses</span> &middot;
        <span><%= number_with_delimiter(@canon_stats[:cross_references]) %> cross-references</span>
        <span class="hm-foot-links">
          <%= link_to "Guide", guide_path %> &middot; <%= link_to "Terms", terms_path %> &middot;
          <%= link_to "Privacy", privacy_path %> &middot; <%= link_to "Credits", credits_path %>
        </span>
      </footer>
    </div>
  </main>
  <%= render "shared/tab_bar", current: :home %>
  <% unless guest %>
    <%= render "studies/new_study_modal" %>
  <% end %>
  <%# Outside .hm-main (its own stacking context), so the modal covers the app bar. %>
  <%= render "daily_words/share_modal", word: @daily_word if @daily_word %>
</div>
