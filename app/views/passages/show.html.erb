<% content_for :title, "#{@reference} · BiblioRata" %>
<%
  meta_desc = (@prayer.presence || @verses.map(&:text).join(" ")).to_s.squish.truncate(180)
  og_image  = "#{request.base_url}/icon.png"
  chapters = @verses.map(&:chapter).uniq
  whole_chapter = chapters.size == 1 && @parsed.verse_start.nil?
  prev_slug = neighbor_passage_slug(@book, chapters.first, :prev) if whole_chapter
  next_slug = neighbor_passage_slug(@book, chapters.last, :next) if whole_chapter
%>
<% content_for :head do %>
  <meta name="description" content="<%= meta_desc %>">
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="BiblioRata">
  <meta property="og:title" content="<%= @reference %> · <%= @translation&.name %>">
  <meta property="og:description" content="<%= meta_desc %>">
  <meta property="og:url" content="<%= passage_url(@slug) %>">
  <meta property="og:image" content="<%= og_image %>">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= @reference %> · <%= @translation&.name %>">
  <meta name="twitter:description" content="<%= meta_desc %>">
  <meta name="twitter:image" content="<%= og_image %>">
<% end %>

<div class="pub-page">
  <header class="ui-appbar pub-appbar">
    <div class="ui-appbar-start">
      <%= link_to root_path, class: "ui-brand" do %>
        <span class="ui-brand-mark" aria-hidden="true"><%= icon(:book) %></span>
        <span class="ui-brand-name">BiblioRata</span>
      <% end %>
    </div>
    <div class="ui-appbar-center"></div>
    <div class="ui-appbar-end">
      <%= render "shared/theme_toggle" %>
      <%= link_to open_passage_path(@slug, t: @translation&.code), class: "ui-btn is-sm is-primary pub-open" do %>
        Open in BiblioRata
      <% end %>
    </div>
  </header>

  <main class="pub-main">
    <article class="rd-column pub-column">
      <header class="rd-chapter-head pub-head">
        <span class="rd-book"><%= @book.name %></span>
        <span class="rd-chapter-num"><%= @reference.delete_prefix("#{@book.name} ") %></span>
        <nav class="pub-versions" aria-label="Version">
          <% Translation.available.each do |t| %>
            <%= link_to t.code, passage_path(@slug, t: t.code), class: "ui-pill#{' is-on' if t == @translation}",
                  "aria-current": (t == @translation ? "page" : nil), title: t.display_name %>
          <% end %>
        </nav>
      </header>

      <div class="pub-verses">
        <% @verses.each_with_index do |v, i| %>
          <% if chapters.size > 1 && (i.zero? || @verses[i - 1].chapter != v.chapter) %>
            <h3 class="pub-chapter-break"><%= @book.name %> <%= v.chapter %></h3>
          <% end %>
          <span class="pub-verse"><% if @verses.size > 1 %><sup class="vn"><%= v.verse_number %></sup><% end %><%= v.text %></span>
        <% end %>
      </div>

      <% if @prayer.present? %>
        <section class="pub-prayer">
          <div class="ui-label">A prayer from <%= @reference %></div>
          <p><%= @prayer %></p>
        </section>
      <% end %>

      <% if prev_slug || next_slug %>
        <nav class="pub-chapters" aria-label="Chapters">
          <% if prev_slug %>
            <%= link_to passage_path(prev_slug, t: @translation&.code), class: "ui-btn", rel: "prev" do %><%= icon(:chevron_left) %> Previous<% end %>
          <% end %>
          <% if next_slug %>
            <%= link_to passage_path(next_slug, t: @translation&.code), class: "ui-btn", rel: "next" do %>Next <%= icon(:chevron_right) %><% end %>
          <% end %>
        </nav>
      <% end %>

      <section class="pub-invite">
        <h2>Read, compare and study &mdash; free</h2>
        <p>
          Open the whole Bible in a calm reader: compare translations side by side, trace
          cross-references, study the original words, and take it into the pulpit.
        </p>
        <%= link_to "Open #{@reference} in BiblioRata", open_passage_path(@slug, t: @translation&.code), class: "ui-btn is-accent" %>
      </section>

      <footer class="pub-foot">
        Scripture from the <%= @translation&.name %>. <%= link_to "Sources & credits", credits_path %>
      </footer>
    </article>
  </main>
</div>
