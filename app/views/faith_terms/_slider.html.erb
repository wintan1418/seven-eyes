<%# The Glossary of the Faith as a row of picture cards you swipe through
    (today's word first; one across on phones, three on laptops). Each card
    opens its word. locals: terms, roots ({term.id => LexiconEntry}), total
    (all visible words), everywhere (shown at every width — home and
    landing), eager_first (false where something above already loads eagerly). %>
<% everywhere = local_assigns.fetch(:everywhere, false) %>
<% eager_first = local_assigns.fetch(:eager_first, true) %>
<section class="hm-glossary<%= " is-everywhere" if everywhere %>" aria-labelledby="hm-glossary-title"
         data-controller="shatter-slider" data-shatter-slider-interval-value="5000">
  <div class="hm-glossary-head">
    <h2 class="ui-label" id="hm-glossary-title">Glossary of the Faith</h2>
    <%= link_to "All #{total}", faith_terms_path, class: "hm-glossary-all" %>
  </div>
  <div class="hm-glossary-track" data-shatter-slider-target="track" tabindex="0"
       aria-roledescription="carousel" aria-label="Words of the faith — swipe to see more">
    <% terms.each_with_index do |term, i| %>
      <% root = roots[term.id] %>
      <%= link_to faith_term_path(term), class: "hm-gl-slide", data: { shatter_slider_target: "slide" },
            aria: { roledescription: "slide", label: "#{i + 1} of #{terms.size}: #{term.name}" } do %>
        <span class="hm-gl-art" aria-hidden="true">
          <%= faith_art_picture(FaithArt.for(term), sizes: "(min-width: 960px) 320px, (min-width: 640px) 50vw, 85vw",
                                loading: i.zero? && eager_first ? "eager" : "lazy", phone_small: true) %>
        </span>
        <span class="hm-gl-text">
          <span class="hm-gl-label"><%= i.zero? ? "Word of the day" : "Glossary of the Faith" %></span>
          <% if term.draft? %><span class="hm-gl-draft">Draft</span><% end %>
          <span class="hm-gl-term"><%= term.name %></span>
          <% if root %>
            <span class="hm-gl-root">
              <span lang="<%= root.language == "hebrew" ? "he" : "grc" %>"><%= root.lemma.presence || root.strongs %></span>
              <% if root.translit.present? %><i><%= root.translit %></i><% end %>
            </span>
          <% end %>
          <span class="hm-gl-def"><%= term.short_definition %></span>
          <span class="hm-gl-open">Open <%= icon(:chevron_right) %></span>
        </span>
      <% end %>
    <% end %>
    <%= link_to faith_terms_path, class: "hm-gl-slide is-more", data: { shatter_slider_target: "slide" } do %>
      <span class="hm-gl-text">
        <span class="hm-gl-label">Glossary of the Faith</span>
        <span class="hm-gl-term">See all <%= total %> words</span>
        <span class="hm-gl-def">What each word means, where it comes from in the Greek and Hebrew, and where to read it in the Bible.</span>
        <span class="hm-gl-open">Open the glossary <%= icon(:chevron_right) %></span>
      </span>
    <% end %>
  </div>
  <div class="hm-glossary-dots" aria-hidden="true">
    <% (terms.size + 1).times do |i| %>
      <button type="button" tabindex="-1" class="hm-gl-dot<%= ' is-on' if i.zero? %>"
              data-shatter-slider-target="dot" data-action="shatter-slider#go" data-index="<%= i %>"></button>
    <% end %>
  </div>
</section>
