<% content_for :title, "Glossary of the Faith · BiblioRata" %>
<% content_for :head do %>
  <meta name="description" content="Plain-English definitions of the great words of the Christian faith — grace, faith, salvation, redemption and more — with their Greek and Hebrew roots and key verses.">
<% end %>
<%# The Glossary of the Faith: every visible term A–Z, filtered as you type (glossary-filter). %>
<div class="ps-root ui-more-page ft-page" data-controller="glossary-filter">
  <%= render "studies/app_bar", title: "Glossary" %>
  <%= render "studies/menu_sheet" %>

  <main class="ft-main">
    <header class="ft-head">
      <span class="ui-label">Glossary of the Faith</span>
      <h1>The words of the faith, in plain English</h1>
      <p>Grace, faith, redemption, righteousness &mdash; what they mean, where they come from in the Greek and Hebrew, and where to read them in the Bible.</p>
    </header>

    <div class="ft-search">
      <label for="ft-search-input" class="sr-only">Search the glossary</label>
      <%= icon(:search) %>
      <input type="search" id="ft-search-input" class="ft-search-input" placeholder="Search — grace, born again, covenant…"
             autocomplete="off" spellcheck="false" enterkeyhint="search"
             data-glossary-filter-target="input" data-action="input->glossary-filter#filter">
    </div>

    <nav class="ft-az" aria-label="Jump to a letter">
      <% @letters.each_key do |letter| %>
        <a href="#ft-letter-<%= letter %>" data-glossary-filter-target="jump" data-letter="<%= letter %>"><%= letter %></a>
      <% end %>
    </nav>

    <% @letters.each do |letter, terms| %>
      <section class="ft-letter" id="ft-letter-<%= letter %>" data-glossary-filter-target="group" data-letter="<%= letter %>">
        <h2 class="ft-letter-head"><%= letter %></h2>
        <ul class="ft-list">
          <% terms.each do |term| %>
            <li data-glossary-filter-target="item" data-search="<%= term.search_text %>">
              <%= link_to faith_term_path(term), class: "ft-item" do %>
                <span class="ft-item-name"><%= term.name %><%= render "faith_terms/draft_badge", term: term %></span>
                <span class="ft-item-def"><%= term.short_definition %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <p class="ft-empty" hidden data-glossary-filter-target="empty">No term matches that yet. Try another word.</p>

    <footer class="ft-foot">
      Definitions are written for this app and reviewed by a pastor. Scripture is quoted from the King James Version;
      root words from Strong&rsquo;s concordance. <%= link_to "Sources & credits", credits_path %>
    </footer>
  </main>
</div>
