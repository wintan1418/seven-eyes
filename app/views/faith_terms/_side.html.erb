<%# The side pane: search, A–Z and every term the viewer may see, the open one
    marked. Its term links open in the "ft-content" frame (faith-pane keeps the
    mark in step after that). On a phone this is the /faith list.
    locals: letters, current %>
<aside class="ft-side" aria-label="All terms" data-controller="glossary-filter">
  <div class="ft-side-top">
    <%= link_to faith_terms_path, class: "ft-side-title", data: { turbo_frame: "ft-content" } do %>
      <span class="ui-label">Glossary of the Faith</span>
      <span class="ft-side-count"><%= pluralize(letters.values.sum(&:size), "word") %> of the faith</span>
    <% end %>

    <div class="ft-search">
      <label for="ft-search-input" class="sr-only">Search the glossary</label>
      <%= icon(:search) %>
      <input type="search" id="ft-search-input" class="ft-search-input" placeholder="Search — grace, born again…"
             autocomplete="off" spellcheck="false" enterkeyhint="search"
             data-glossary-filter-target="input" data-action="input->glossary-filter#filter">
    </div>

    <nav class="ft-az" aria-label="Jump to a letter">
      <% letters.each_key do |letter| %>
        <a href="#ft-letter-<%= letter %>" data-glossary-filter-target="jump" data-letter="<%= letter %>"
           data-action="glossary-filter#jump"><%= letter %></a>
      <% end %>
    </nav>
  </div>

  <div class="ft-side-list" data-glossary-filter-target="list">
    <% letters.each do |letter, terms| %>
      <section class="ft-letter" id="ft-letter-<%= letter %>" data-glossary-filter-target="group" data-letter="<%= letter %>">
        <h2 class="ft-letter-head"><%= letter %></h2>
        <ul class="ft-list">
          <% terms.each do |term| %>
            <li data-glossary-filter-target="item" data-search="<%= term.search_text %>">
              <%= link_to faith_term_path(term), class: "ft-item", aria: { current: (term == current ? "page" : nil) },
                                                data: { turbo_frame: "ft-content" } do %>
                <span class="ft-item-name"><%= term.name %><%= render "faith_terms/draft_badge", term: term %></span>
                <span class="ft-item-def"><%= term.short_definition %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <p class="ft-empty" hidden data-glossary-filter-target="empty">No term matches that yet. Try another word.</p>
  </div>

  <p class="ft-side-foot">
    Written for this app and reviewed by a pastor. <%= link_to "Sources & credits", credits_path %>
  </p>
</aside>
