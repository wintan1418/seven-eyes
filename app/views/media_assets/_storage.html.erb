<%# The account's storage: used of the quota, and how many pictures. %>
<% used = storage[:used_bytes]; quota = storage[:quota_bytes]; total = current_user.media_assets.count %>
<div class="mm-storage" data-media-library-target="storage" data-count="<%= total %>">
  <progress class="ui-offline-bar" max="<%= quota %>" value="<%= [ used, quota ].min %>"
            aria-label="Storage used"></progress>
  <span><%= number_to_human_size(used) %> of <%= number_to_human_size(quota) %> used &middot;
    <%= pluralize(total, "picture") %></span>
</div>
