// BiblioRata service worker — see app/javascript/service_worker.js for what it
// does. The worker's code is bundled by esbuild (yarn build) and inlined
// below, so the browser installs a new worker whenever that code, or the
// deployed CSS/JS, changes.
//
// Never keeps another reader's data: saved pages and queued writes are
// cleared on sign-out ({type: "clear-caches"}) and when a different reader
// signs in on the device. Redirected (!response.redirected), non-200 and
// opaque responses are never cached as-is; pages are networkFirst.
<% assets = [ asset_path("application.js"), asset_path("application.css") ] %>
<% worker = Rails.root.join("app/assets/builds/service_worker.js") %>
<% worker_source = worker.exist? ? worker.read.gsub(%r{^//# sourceMappingURL=.*$}, "") : "" %>
<% version = Digest::SHA256.hexdigest((assets + [ Digest::SHA256.hexdigest(worker_source) ]).join("|"))[0, 12] %>
const CACHE_VERSION = "ps-<%= version %>"
self.PS_SW = { version: CACHE_VERSION, assets: <%= raw assets.to_json %> }
;(() => {
<%= raw worker_source %>
})()
